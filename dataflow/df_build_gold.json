{
	"name": "df_build_gold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_sales_parquet",
						"type": "DatasetReference"
					},
					"name": "srcsilversales"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_daily_store_summary",
						"type": "DatasetReference"
					},
					"name": "sinkgolddailystore"
				}
			],
			"transformations": [
				{
					"name": "aggdailystore"
				}
			],
			"scriptLines": [
				"source(output(",
				"          TransactionID as string,",
				"          StoreID as string,",
				"          ProductID as string,",
				"          Quantity as integer,",
				"          UnitPrice as double,",
				"          DiscountPct as double,",
				"          TransactionDate as date,",
				"          PaymentMode as string,",
				"          NetAmount as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> srcsilversales",
				"srcsilversales aggregate(groupBy(StoreID,",
				"          TransactionDate),",
				"     TotalSales = round(sum(NetAmount), 2),",
				"          TotalTransactions = count(TransactionID),",
				"          TotalQuantity = sum(Quantity)) ~> aggdailystore",
				"aggdailystore sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkgolddailystore"
			]
		}
	}
}