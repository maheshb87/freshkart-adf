{
	"name": "pl_ingest_store_files",
	"properties": {
		"activities": [
			{
				"name": "cp_incoming_to_bronze",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": "incoming",
							"wildcardFileName": "*.csv",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_adls_csv_param",
						"type": "DatasetReference",
						"parameters": {
							"container": "store-upload",
							"folder": "incoming"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_csv_param",
						"type": "DatasetReference",
						"parameters": {
							"container": "bronze",
							"folder": "@concat('store_sales/', formatDateTime(utcnow(),'yyyy/MM/dd'))"
						}
					}
				]
			},
			{
				"name": "gm_list_incoming",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "cp_incoming_to_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_adls_folder_param",
						"type": "DatasetReference",
						"parameters": {
							"container": "store-upload",
							"folder": "incoming"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "fe_archive_files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "gm_list_incoming",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('gm_list_incoming').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "cp_to_archive",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_adls_binary_param",
									"type": "DatasetReference",
									"parameters": {
										"container": "store-upload",
										"folder": "incoming",
										"file": "@item().name"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_binary_param",
									"type": "DatasetReference",
									"parameters": {
										"container": "store-upload",
										"folder": "@concat('archive/', formatDateTime(utcnow(),'yyyy/MM/dd'))",
										"file": "@item().name"
									}
								}
							]
						},
						{
							"name": "del_incoming_file",
							"type": "Delete",
							"dependsOn": [
								{
									"activity": "cp_to_archive",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_adls_binary_param",
									"type": "DatasetReference",
									"parameters": {
										"container": "store-upload",
										"folder": "incoming",
										"file": "@item().name"
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-22T17:29:57Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}